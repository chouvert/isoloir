---
// Liste compacte des sources d'une position : chaque titre renvoie à la page lue.
interface Source { titre?: string; url?: string }
interface Props { sources?: Source[] }
const { sources = [] } = Astro.props;
const liste = (sources ?? []).filter((s) => s && (s.titre || s.url));
---
{liste.length > 0 && (
  <p class="sources legende">
    <span>{liste.length > 1 ? 'Sources' : 'Source'} :</span>{' '}
    {liste.map((s, i) => (
      <Fragment>
        {s.url ? <a href={s.url}>{s.titre || s.url}</a> : <span>{s.titre}</span>}{i < liste.length - 1 ? ' ; ' : ''}
      </Fragment>
    ))}
  </p>
)}

<style>
  .sources { margin: 2px 0 0; overflow-wrap: anywhere; }
</style>
