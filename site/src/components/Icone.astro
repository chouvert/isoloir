---
// Icônes au trait, en couleur du texte (charte : épaisseur égale à celle du bulletin du logo).
// Jamais d'icône pour représenter un candidat ou un parti.
interface Props {
  nom: 'bulletin' | 'bulletin-coche' | 'fiche' | 'comparer' | 'methode' | 'balance' | 'source' | 'bouclier' | 'jauge';
  taille?: number;
}
const { nom, taille = 24 } = Astro.props;
---
<svg aria-hidden="true" width={taille} height={taille} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {nom === 'bulletin' && <rect x="5" y="2" width="14" height="20" rx="2" />}
  {nom === 'bulletin-coche' && <Fragment><rect x="5" y="2" width="14" height="20" rx="2" /><path d="M8.5 12.5l2.6 2.6 4.6-5.2" /></Fragment>}
  {nom === 'fiche' && <Fragment><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" /></Fragment>}
  {nom === 'comparer' && <Fragment><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M12 4v16" /></Fragment>}
  {nom === 'methode' && <Fragment><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8v.01" /></Fragment>}
  {nom === 'balance' && <Fragment><path d="M12 4v16M8 20h8M5 7h14" /><path d="M5 7l-3 6a3 3 0 0 0 6 0z" /><path d="M19 7l-3 6a3 3 0 0 0 6 0z" /></Fragment>}
  {nom === 'source' && <Fragment><path d="M12 21H5V3h9l4 4v4" /><path d="M14 3v4h4M8 9h5M8 13h3" /><circle cx="16.5" cy="16.5" r="3" /><path d="M18.7 18.7L21 21" /></Fragment>}
  {nom === 'bouclier' && <Fragment><path d="M12 2.5l7.5 3v5.5c0 4.6-3.1 8.4-7.5 10.5-4.4-2.1-7.5-5.9-7.5-10.5V5.5z" /><path d="M8.8 12l2.2 2.2 4.2-4.4" /></Fragment>}
  {nom === 'jauge' && <Fragment><path d="M3 17a9 9 0 0 1 18 0" /><path d="M12 17l4.5-5" /><circle cx="12" cy="17" r="1.2" /><path d="M6 13.5l1.2.9M12 8v1.5M18 13.5l-1.2.9" /></Fragment>}
</svg>
